# Environment Variables Template for TravelIQ
# Copy this file to .env and fill in your actual values

# Google AI API Key (required for AI features)
# Get your key from: https://aistudio.google.com/app/apikey
VITE_GOOGLE_API_KEY=demo_key_replace_with_real

# Serper API Key (for current travel news fetching)
# Get your key from: https://serper.dev
# This fetches real-time travel industry news for the news ticker
VITE_SERPER_API_KEY=demo_key_replace_with_real

# ElevenLabs API Key (optional, for premium voice on supplier chatbots)
# Get your key from: https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=

# Supabase (required for supplier self-service portal & auth)
# Find these at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://ypciahmwkiivenlvcoev.supabase.co
VITE_SUPABASE_ANON_KEY=

# Important Notes:
# - Both keys MUST be prefixed with VITE_ for Vite compatibility
# - Replace demo_key_replace_with_real with your actual API keys
# - News ticker will show current travel trade news when properly configured
# - Blog content focuses exclusively on TravelIQ platform benefits