# Environment Variables Template for TravelIQ
# Copy this file to .env and fill in your actual values

# Google AI API Key (required for AI features)
# Get your key from: https://aistudio.google.com/app/apikey
# SERVER-SIDE ONLY (no VITE_ prefix): consumed by the /api/gemini proxy
# (functions/api/gemini) and the matching dev proxy in vite.config.ts, so it is
# never inlined into the public client bundle. In Cloudflare, set this as a
# plain (non-VITE_) build/runtime environment variable.
GOOGLE_API_KEY=demo_key_replace_with_real

# Serper API Key (for current travel news fetching)
# Get your key from: https://serper.dev
# SERVER-SIDE ONLY: consumed by the /api/news proxy (functions/api/news.ts).
SERPER_API_KEY=demo_key_replace_with_real

# ElevenLabs API Key (optional, for premium voice on supplier chatbots)
# Get your key from: https://elevenlabs.io
# SERVER-SIDE ONLY: consumed by the /api/elevenlabs-tts proxy.
ELEVENLABS_API_KEY=

# Supabase (required for supplier self-service portal & auth)
# Find these at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://ypciahmwkiivenlvcoev.supabase.co
VITE_SUPABASE_ANON_KEY=

# Important Notes:
# - GOOGLE_API_KEY, SERPER_API_KEY and ELEVENLABS_API_KEY are SERVER-SIDE only
#   (no VITE_ prefix) — they are held by the /api/* proxy functions and never
#   shipped to the browser. Only VITE_SUPABASE_* are exposed to the client.
# - Replace demo_key_replace_with_real with your actual API keys
# - News ticker will show current travel trade news when properly configured
# - Blog content focuses exclusively on TravelIQ platform benefits